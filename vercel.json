{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://it-sparks-backend.onrender.com/sitemap.xml"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "itsparkstech.com"
        }
      ],
      "destination": "https://www.itsparkstech.com/:path*",
      "permanent": true
    }
  ]
}